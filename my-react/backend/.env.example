# Copy these settings into the environment where the FastAPI server runs.
# Brevo credentials must never be placed in the React/Vite environment.
TOKA_FRONTEND_URL=http://localhost:5173
TOKA_PUBLIC_API_URL=http://127.0.0.1:8000
TOKA_DATABASE_PATH=backend/toka.sqlite3
TOKA_ALLOWED_ORIGINS=http://localhost:5173
TOKA_COOKIE_SECURE=false

# Create a Brevo API key and verify the sender address in Brevo first.
TOKA_BREVO_API_KEY=your-brevo-api-key
TOKA_EMAIL_FROM=members@your-domain.example
TOKA_EMAIL_SENDER_NAME=ToKa Fitness
