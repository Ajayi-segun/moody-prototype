# Copy these settings into the environment where the FastAPI server runs.
# Brevo credentials must never be placed in the React/Vite environment.
TOKA_FRONTEND_URL=http://localhost:5173
TOKA_BACKEND_URL=http://localhost:8000
TOKA_ALLOWED_ORIGINS=http://localhost:5173

# Required for account registration and authentication.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
DATABASE_NAME=toka_fitness
JWT_SECRET=fkebhkvebkbrvkbkfuhuohfruohrfhoukbrfihoiufhoruhouruhuohuh

# Create a Brevo API key and verify the sender address in Brevo first.
TOKA_BREVO_API_KEY=your-brevo-api-key
TOKA_EMAIL_FROM=members@your-domain.example
TOKA_EMAIL_SENDER_NAME=ToKa Fitness

# Supabase stores mailing-list subscriptions. Keep the service-role key private.
TOKA_SUPABASE_URL=https://your-project.supabase.co
TOKA_SUPABASE_SECRET_KEY=your-supabase-service-role-key

# Stripe hosted Checkout. Create monthly GBP Prices at the displayed tier amounts
# (£18 Premium, £30 Pro, £40 Ultimate) and configure
# a webhook for checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted, invoice.paid, and invoice.payment_failed.
TOKA_STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
TOKA_STRIPE_PRICE_PREMIUM=price_your-monthly-premium-price
TOKA_STRIPE_PRICE_PRO=price_your-monthly-pro-price
TOKA_STRIPE_PRICE_ULTIMATE=price_your-monthly-ultimate-price
TOKA_STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
